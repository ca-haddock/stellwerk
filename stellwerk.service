[Unit]
Description=Stellwerk Network Gateway Manager
Documentation=https://github.com/local/stellwerk
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/home/stellwerk/bin/stellwerk --config /home/stellwerk/config.toml
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=stellwerk

# Läuft als dedizierter User – CAP_NET_ADMIN via setcap auf dem Binary
User=stellwerk

[Install]
WantedBy=multi-user.target
