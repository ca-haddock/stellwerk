[Unit]
Description=Stellwerk Network Gateway Manager
Documentation=https://github.com/local/stellwerk
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStartPre=/bin/bash /home/stellwerk/failsafe.sh
ExecStart=/home/stellwerk/bin/stellwerk --config /home/stellwerk/config.toml
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=stellwerk

# Needs root for nft and ip rule
User=root

[Install]
WantedBy=multi-user.target
