[Unit]
Description=Stellwerk Network Gateway Manager
Documentation=https://github.com/local/stellwerk
After=network.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/home/stellwerk/bin/stellwerk --config /home/stellwerk/config.toml
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=stellwerk

# CAP_NET_ADMIN via AmbientCapabilities – wird an Child-Prozesse (ip, nft, wg) vererbt.
# NICHT setcap auf dem Binary verwenden – das löscht AmbientCaps beim Exec.
# Kein CapabilityBoundingSet – sudo braucht CAP_SETUID/SETGID (für wg-helper.sh).
User=stellwerk
AmbientCapabilities=CAP_NET_ADMIN

[Install]
WantedBy=multi-user.target
